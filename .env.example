# ==========================================
# MIRAGE-SHIELD Environment Configuration
# ==========================================

# Ring Partner API (api.amazonvision.com)
RING_API_TOKEN=your_ring_playground_or_oauth_token_here
RING_API_BASE_URL=https://api.amazonvision.com
RING_WEBHOOK_SECRET=your_hmac_webhook_secret_here
RING_DOORBELL_DEVICE_ID=ring_doorbell_front_01
RING_CHIME_DEVICE_ID=ring_chime_hall_01
# Set to 'true' to use the built-in Ring Sandbox / Emulator when token expires or testing offline
RING_SANDBOX_MODE=true

# AWS Configuration (Bedrock, KMS, DynamoDB, Lambda)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
DYNAMODB_INCIDENTS_TABLE=mirage_shield_incidents
KMS_KEY_ID=alias/mirage-shield-ledger-key
# Set to 'true' to run AWS services in self-contained resilient local mode if AWS credentials not active
AWS_LOCAL_SIMULATION_MODE=false

# Fire TV & Vega OS Takeover Configuration
FIRETV_HOST=127.0.0.1
FIRETV_PORT=8000
VEGA_DEVICE_ID=vega_virtual_device_01

# System Ports
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
